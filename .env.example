# Neekan Consulting LLP - Employee CRM Suite
# Cloudinary Configuration for Image/Photo Uploads (Unsigned Direct Upload)

# 1. Your Cloudinary Cloud Name (from your Cloudinary dashboard)
VITE_CLOUDINARY_CLOUD_NAME=

# 2. Your Unsigned Upload Preset (Cloudinary Settings > Upload > Upload presets > Add preset with Signing Mode = Unsigned)
VITE_CLOUDINARY_UPLOAD_PRESET=

# 3. Optional folder name in Cloudinary
VITE_CLOUDINARY_FOLDER=neekan_emp
